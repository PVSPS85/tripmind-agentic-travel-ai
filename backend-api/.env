# Core App Settings
APP_NAME="TripMind AI Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace_with_a_highly_secure_random_hex_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database / Supabase Connection (PostgreSQL Direct URI or Transaction Pooler)
DATABASE_URL="postgresql+asyncpg://postgres:your-supabase-password@db.your-project-ref.supabase.co:6543/postgres"

# LLM & Multi-Agent Inference (Groq Cloud)
GROQ_API_KEY="gsk_your_actual_groq_api_key_here"
GROQ_MODEL_NAME="llama3-70b-8192"

# External Search Agent Tools
SERPER_API_KEY="your_serper_dev_api_key_here"
OPENWEATHER_API_KEY="your_openweather_api_key_here"
GEOAPIFY_API_KEY="your_geoapify_or_google_places_api_key_here"
